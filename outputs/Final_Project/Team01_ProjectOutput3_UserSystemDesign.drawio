        <mxCell id="box_form_state" parent="1" style="shape=rect;html=1;whiteSpace=wrap;overflow=hidden;rounded=1;strokeColor=#003366;fillColor=#f0f4f8;strokeWidth=1.5;" value="&lt;div style=&quot;text-align:left;padding:8px;color:#000000;&quot;&gt;&lt;b style=&quot;font-size:14px;color:#000000;&quot;&gt;Form State&lt;/b&gt;&lt;hr style=&quot;margin:6px 0;&quot;&gt;&lt;table border=&quot;0&quot; style=&quot;width:100%;font-size:10px;color:#000000;&quot; cellpadding=&quot;4&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:45%;vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#000000;&quot;&gt;State Description:&lt;/b&gt;&lt;br&gt;Activity Logging Form View displaying header context (&lt;b&gt;Walk 20K | Activity: walk&lt;/b&gt;), active date bounds (2026-08-01 to 2026-08-31), input fields for Amount (with explicit &lt;b&gt;&amp;quot;km&amp;quot;&lt;/b&gt; unit label), Activity Date (YYYY-MM-DD), optional Note, plus &lt;b&gt;Submit Activity&lt;/b&gt; and &lt;b&gt;Cancel&lt;/b&gt; buttons.&lt;/td&gt;&lt;td style=&quot;width:55%;vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#000000;&quot;&gt;Design Decisions &amp;amp; Annotations:&lt;/b&gt;&lt;ul style=&quot;margin:4px 0;padding-left:16px;color:#000000;&quot;&gt;&lt;li&gt;&lt;b&gt;Decision:&lt;/b&gt; Header displays Walk 20K, walk, and explicit km unit label beside amount input.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Evidence:&lt;/b&gt; C001 Spec (goal_unit=&#39;km&#39;); Act 1 Unit Risk&lt;/li&gt;&lt;li&gt;&lt;b&gt;Requirement:&lt;/b&gt; U2 (Context &amp;amp; Unit Visibility)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Rationale:&lt;/b&gt; Prevents measurement unit ambiguity under outdoor screen glare.&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="1000" x="50" y="220" as="geometry" />
