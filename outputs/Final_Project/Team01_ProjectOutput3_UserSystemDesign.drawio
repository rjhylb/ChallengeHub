        <mxCell id="box_entry_state" parent="1" style="shape=rect;html=1;whiteSpace=wrap;overflow=hidden;rounded=1;strokeColor=#003366;fillColor=#f0f4f8;strokeWidth=1.5;" value="&lt;div style=&quot;text-align:left;padding:8px;color:#000000;&quot;&gt;&lt;b style=&quot;font-size:14px;color:#000000;&quot;&gt;Entry State&lt;/b&gt;&lt;hr style=&quot;margin:6px 0;&quot;&gt;&lt;table border=&quot;0&quot; style=&quot;width:100%;font-size:10px;color:#000000;&quot; cellpadding=&quot;4&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:45%;vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#000000;&quot;&gt;State Description:&lt;/b&gt;&lt;br&gt;Active Challenge Dashboard View displaying the &lt;b&gt;C001 Walk 20K&lt;/b&gt; summary card (Target: 20.0 km, Active: 2026-08-01 to 2026-08-31) with a prominent, high-contrast &lt;b&gt;&amp;quot;Record Activity&amp;quot;&lt;/b&gt; primary action button.&lt;/td&gt;&lt;td style=&quot;width:55%;vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#000000;&quot;&gt;Design Decisions &amp;amp; Annotations:&lt;/b&gt;&lt;ul style=&quot;margin:4px 0;padding-left:16px;color:#000000;&quot;&gt;&lt;li&gt;&lt;b&gt;Decision:&lt;/b&gt; Direct &amp;quot;Record Activity&amp;quot; action button placed directly on active challenge card.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Evidence:&lt;/b&gt; UC-05 Step 1; Act 1 Task Risk Step 1&lt;/li&gt;&lt;li&gt;&lt;b&gt;Requirement:&lt;/b&gt; U1 (Discovery &amp;amp; Trigger Path)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Rationale:&lt;/b&gt; Enables rapid discovery (&amp;le; 3s) for outdoor mobile users without deep navigation friction.&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" vertex="1">
