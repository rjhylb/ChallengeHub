          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_strat_ar" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c757d;strokeWidth=1;endArrow=open;dashed=1;fontColor=#555555;fontSize=9;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="cls_ar_ref">
          <mxGeometry relative="1" x="0.1661" as="geometry">
            <Array as="points">
              <mxPoint x="880" y="174.2" />
              <mxPoint x="880" y="200" />
              <mxPoint x="720" y="200" />
