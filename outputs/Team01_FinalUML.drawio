            </Array>
            <mxPoint x="870" y="174.2" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_strat_ar" parent="edge_strat_ar" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#555555;fontSize=9;" value="processes records" vertex="1">
          <mxGeometry relative="1" x="0.3614" y="-10" as="geometry">
            <mxPoint y="-25" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_strat_ch" edge="1" parent="1" source="cls_strat_iface" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c757d;strokeWidth=1;endArrow=open;dashed=1;fontColor=#555555;fontSize=9;exitX=0;exitY=0.322;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="cls_ch_ref_attrs">
          <mxGeometry relative="1" x="0.095" as="geometry">
            <Array as="points">
              <mxPoint x="625" y="120" />
              <mxPoint x="440" y="120.5" />
            </Array>
            <mxPoint x="270" y="140" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_strat_ch" parent="edge_strat_ch" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#555555;fontSize=9;" value="«references target»" vertex="1">
          <mxGeometry relative="1" x="0.2864" y="-10" as="geometry">
            <mxPoint x="25" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="box_pattern_rationale" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#6c757d;strokeWidth=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=10;fontColor=#000000;fontSize=9.5;" value="&lt;b style=&quot;font-size:10.5px;&quot;&gt;Architecture Decision Record (ADR) - Strategy Pattern Justification:&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;p style=&quot;margin:0px; line-height:1.35;&quot;&gt;• &lt;b&gt;Concrete Problem Addressed:&lt;/b&gt; ChallengeHub requires fundamentally distinct progress metrics across challenge types: distance challenges sum continuous values (&lt;i&gt;AmountProgressStrategy&lt;/i&gt;), while habit/session challenges count discrete occurrences (&lt;i&gt;CountProgressStrategy&lt;/i&gt;). Hardcoding conditional checks inside &lt;i&gt;ChallengeManager&lt;/i&gt; creates high cyclomatic complexity and violates the Open/Closed Principle.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Selected Pattern Role:&lt;/b&gt; Implements the Gang-of-Four &lt;b&gt;Strategy Pattern&lt;/b&gt;. The interface &lt;i&gt;ProgressStrategy&lt;/i&gt; encapsulates the calculation algorithm. New metric behaviors (e.g., pace, elevation, weighted sums) can be integrated without modifying the core application coordinator.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Trade-Offs &amp;amp; Deferred Alternatives:&lt;/b&gt;&lt;br&gt;  - &lt;i&gt;Factory Pattern Rejected:&lt;/i&gt; Instantiating strategy instances via a dedicated Factory class was rejected as decorative abstraction; a direct dictionary lookup inside &lt;i&gt;_get_strategy()&lt;/i&gt; is cohesive and maintainable.&lt;br&gt;  - &lt;i&gt;Observer Pattern Rejected:&lt;/i&gt; Progress notifications via publisher/subscriber listeners were deferred to avoid speculative complexity in a synchronous CLI runtime.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Derived Progress Invariant:&lt;/b&gt; The system enforces that progress is purely dynamic—calculated upon query from the immutable accepted records collection, eliminating the risk of stored state drift or synchronization bugs.&lt;/p&gt;" vertex="1">
          <mxGeometry height="230" width="750" x="440" y="470" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="E3QWeypA7RK2YwfvggKF" name="5 Traceability Matrix">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hdr_banner" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#000066;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="64" width="790" x="30" y="30" as="geometry" />
        </mxCell>
        <mxCell id="page_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;b style=&quot;font-size: 17px; color: #ffffff;&quot;&gt;5 CROSS-MODEL TRACEABILITY MATRIX&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #e0e0e0;&quot;&gt;Requirements, Operational Contracts, Architecture Layers &amp;amp; Verification Mapping&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="600" x="125" y="42" as="geometry" />
        </mxCell>
        <mxCell id="tbl_container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c757d;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;fontColor=#000000;" value="" vertex="1">
          <mxGeometry height="425" width="790" x="30" y="110" as="geometry" />
        </mxCell>
        <mxCell id="tbl_content" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#000000;fontSize=9.5;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse: collapse; width: 100%; border: 1px solid #495057;&quot;&gt;   &lt;tr style=&quot;background-color: #f1f3f5; text-align: center; font-weight: bold;&quot;&gt;     &lt;td style=&quot;width: 10%;&quot;&gt;Req. ID&lt;/td&gt;     &lt;td style=&quot;width: 14%;&quot;&gt;Use Case / Task&lt;/td&gt;     &lt;td style=&quot;width: 25%;&quot;&gt;Operational Contract Clause&lt;/td&gt;     &lt;td style=&quot;width: 26%;&quot;&gt;Model &amp;amp; Code Component&lt;/td&gt;     &lt;td style=&quot;width: 25%;&quot;&gt;Verification Evidence&lt;/td&gt;   &lt;/tr&gt;   &lt;tr&gt;     &lt;td style=&quot;text-align: center; font-weight: bold;&quot;&gt;FB-01&lt;br&gt;FB-02&lt;/td&gt;     &lt;td&gt;&lt;b&gt;UC-05&lt;/b&gt;: Record Activity (Normal Path)&lt;/td&gt;     &lt;td&gt;&lt;b&gt;Success Postcondition:&lt;/b&gt; Exactly one valid ActivityRecord is instantiated, appended to in-memory activities collection, and persisted once.&lt;/td&gt;     &lt;td&gt;• &lt;b&gt;Page 1/2:&lt;/b&gt; ChallengeManager, ActivityRecord&lt;br&gt;• &lt;b&gt;Page 3:&lt;/b&gt; Messages 1.5, 1.6, 1.7, 1.8&lt;br&gt;• &lt;b&gt;Code:&lt;/b&gt; manager.py &lt;i&gt;record_activity()&lt;/i&gt;&lt;/td&gt;     &lt;td&gt;&lt;b&gt;Notebook Act 4:&lt;/b&gt; Normal Path Execution&lt;br&gt;• Count: 3 → 4&lt;br&gt;• Total updates: 7.5 → 9.5 km&lt;br&gt;• Disk: CSV row appended (atomic)&lt;/td&gt;   &lt;/tr&gt;   &lt;tr style=&quot;background-color: #fafafa;&quot;&gt;     &lt;td style=&quot;text-align: center; font-weight: bold;&quot;&gt;FB-03&lt;br&gt;FB-04&lt;/td&gt;     &lt;td&gt;&lt;b&gt;UC-05&lt;/b&gt;: Guard &amp;amp; Failure Invariant&lt;/td&gt;     &lt;td&gt;&lt;b&gt;Precondition &amp;amp; Failure Invariant:&lt;/b&gt; Validates referential existence, enrollment, date window, and positive amount. Rejection causes ZERO state mutation.&lt;/td&gt;     &lt;td&gt;• &lt;b&gt;Page 2:&lt;/b&gt; _validate_preconditions()&lt;br&gt;• &lt;b&gt;Page 3:&lt;/b&gt; Messages 1.1–1.4 &amp;amp; &lt;i&gt;alt [precondition fails]&lt;/i&gt;&lt;br&gt;• &lt;b&gt;Code:&lt;/b&gt; manager.py in-memory guards&lt;/td&gt;     &lt;td&gt;&lt;b&gt;Notebook Act 4:&lt;/b&gt; Failure Invariant Check&lt;br&gt;• Raises &lt;i&gt;ValueError&lt;/i&gt;&lt;br&gt;• Count unchanged: 5 → 5&lt;br&gt;• Disk/Memory: Zero state mutation&lt;/td&gt;   &lt;/tr&gt;   &lt;tr&gt;     &lt;td style=&quot;text-align: center; font-weight: bold;&quot;&gt;FB-05&lt;/td&gt;     &lt;td&gt;&lt;b&gt;UC-04&lt;/b&gt;: View Progress&lt;/td&gt;     &lt;td&gt;&lt;b&gt;Derived Query:&lt;/b&gt; Progress is calculated on demand from accepted activities using the assigned strategy; no mutable stored total column.&lt;/td&gt;     &lt;td&gt;• &lt;b&gt;Page 2/4:&lt;/b&gt; ProgressStrategy, AmountProgressStrategy, CountProgressStrategy&lt;br&gt;• &lt;b&gt;Code:&lt;/b&gt; strategies.py, manager.progress(), manager._get_strategy()&lt;/td&gt;     &lt;td&gt;&lt;b&gt;Reconciled PO4 Evidence:&lt;/b&gt;&lt;br&gt;• Summary: 7.5 km / 20.0 km target (37.5% baseline completion)&lt;br&gt;• Matplotlib progress curve (P001 / C001)&lt;/td&gt;   &lt;/tr&gt;   &lt;tr style=&quot;background-color: #fafafa;&quot;&gt;     &lt;td style=&quot;text-align: center; font-weight: bold;&quot;&gt;FB-07&lt;br&gt;NFB-03&lt;/td&gt;     &lt;td&gt;Persistence &amp;amp; Durability&lt;/td&gt;     &lt;td&gt;&lt;b&gt;Persistence Postcondition:&lt;/b&gt; Accepted activity records survive application shutdown; reload re-establishes state without loss.&lt;/td&gt;     &lt;td&gt;• &lt;b&gt;Page 1/2:&lt;/b&gt; «module» storage.py&lt;br&gt;• &lt;b&gt;Page 3:&lt;/b&gt; Message 1.7 save_activities()&lt;br&gt;• &lt;b&gt;Code:&lt;/b&gt; storage.py CSV serialization&lt;/td&gt;     &lt;td&gt;&lt;b&gt;Notebook Act 4:&lt;/b&gt; Persistence Durability&lt;br&gt;• activities.csv line count = 6 (1 hdr + 5 rows)&lt;br&gt;• Reloaded manager restored count=5 and total=9.51 km&lt;/td&gt;   &lt;/tr&gt;   &lt;tr&gt;     &lt;td style=&quot;text-align: center; font-weight: bold;&quot;&gt;NFB-01&lt;br&gt;NFB-02&lt;/td&gt;     &lt;td&gt;Layering &amp;amp; Error Handling&lt;/td&gt;     &lt;td&gt;&lt;b&gt;Architectural Integrity &amp;amp; Error Safety:&lt;/b&gt; Unidirectional downward dependencies; domain core has 0 external I/O imports; CLI catches exceptions to prevent stack trace crashes.&lt;/td&gt;     &lt;td&gt;• &lt;b&gt;Page 1:&lt;/b&gt; Presentation → Application → Domain / Persistence&lt;br&gt;• &lt;b&gt;Page 3:&lt;/b&gt; CLI catches ValueError&lt;br&gt;• &lt;b&gt;Code:&lt;/b&gt; cli.py, manager.py, models.py&lt;/td&gt;     &lt;td&gt;&lt;b&gt;Notebook Act 1 &amp;amp; Act 4:&lt;/b&gt;&lt;br&gt;• AST import inspection confirms models.py has no UI/file imports&lt;br&gt;• Fresh ZIP extract passes pytest 3/3&lt;/td&gt;   &lt;/tr&gt; &lt;/table&gt;" vertex="1">
          <mxGeometry height="425" width="730" x="60" y="125" as="geometry" />
        </mxCell>
        <mxCell id="box_baseline_freeze" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#6c757d;strokeWidth=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=10;fontColor=#000000;fontSize=10;" value="&lt;b style=&quot;font-size:11px;&quot;&gt;Module 2 Release Candidate Baseline Summary &amp;amp; Handoff Gate:&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;p style=&quot;margin:0px; line-height:1.4;&quot;&gt;• &lt;b&gt;Authoritative Model Scope:&lt;/b&gt; Pages 1 through 5 represent the fully reconciled implementation state frozen from Lesson 7 (M2LA2) and verified in Lesson 8 (PO4/M2CW). All classes, associations, and lifelines correspond directly to the executable Python prototype.&lt;br&gt;• &lt;b&gt;Invariant Inviolability:&lt;/b&gt; Verified that invalid submissions never mutate state (FB-04), progress calculations remain dynamically derived (FB-05), and persistence operates atomically via approved write-through boundaries (FB-07).&lt;br&gt;• &lt;b&gt;Handoff to Module IS:&lt;/b&gt; This design workbook, along with &lt;i&gt;Team01_M2CW_Codebase.zip&lt;/i&gt; and &lt;i&gt;Team01_M2CW_ReleaseCandidate.ipynb&lt;/i&gt;, freezes the baseline architecture for the Final Integration Project (embedded SQLite migration and formal Repository pattern implementation).&lt;/p&gt;" vertex="1">
          <mxGeometry height="145" width="750" x="40" y="550" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
