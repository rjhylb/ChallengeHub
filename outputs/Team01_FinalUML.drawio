        <mxCell id="msg_1_7" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;verticalAlign=bottom;endArrow=block;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9.5;" value="1.7: save_activities(self.activities, path)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="435" y="625" as="sourcePoint" />
            <mxPoint x="750" y="625" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_1_7_ack" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=9;" value="atomic CSV write confirmed">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="650" as="sourcePoint" />
            <mxPoint x="435" y="650" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_1_8" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9.5;" value="1.8: return ActivityRecord">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="435" y="680" as="sourcePoint" />
            <mxPoint x="265" y="680" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_confirm_user" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9.5;" value="display confirmation (&quot;Activity recorded for P001: 2.0 km&quot;)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="265" y="710" as="sourcePoint" />
            <mxPoint x="110" y="710" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note_contract" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#6c757d;strokeWidth=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;fontColor=#000000;fontSize=9.5;" value="&lt;b&gt;Lesson 5 &amp;amp; Lesson 7 Operational Contract Traceability:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Before Mutation Phase:&lt;/b&gt; Steps 1.1 to 1.4 evaluate all integrity constraints purely in memory (referential validity, active enrollment pairing, matching activity type, calendar window, and strictly positive amounts).&lt;br&gt;• &lt;b&gt;Failure Invariant (FB-04):&lt;/b&gt; If any precondition fails, execution halts immediately with a specific exception (&lt;i&gt;ValueError&lt;/i&gt;). No &lt;i&gt;ActivityRecord&lt;/i&gt; is created, memory is unmutated, and storage is not touched.&lt;br&gt;• &lt;b&gt;After Validation Succeeded:&lt;/b&gt; Exactly one record is created (1.5), appended to memory (1.6), persisted once through the approved storage boundary (1.7), and returned to the presentation boundary (1.8)." vertex="1">
          <mxGeometry height="110" width="750" x="45" y="760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
