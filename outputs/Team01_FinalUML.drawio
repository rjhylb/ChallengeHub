        </mxCell>
        <mxCell id="page_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;span style=&quot;color: #ffffff;&quot;&gt;&lt;b style=&quot;font-size: 18px;&quot;&gt;1 ARCHITECTURE OVERVIEW&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;ChallengeHub Logical Layer Decomposition &amp;amp; Boundary Rules&lt;/b&gt;&lt;/span&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="600" x="130" y="37" as="geometry" />
        </mxCell>
        <mxCell id="layer_pres" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f8f9fa;strokeColor=#6c757d;strokeWidth=1.5;fontSize=11;fontColor=#000000;rounded=1;arcSize=3;" value="&lt;b&gt;Presentation Layer&lt;/b&gt;" vertex="1">
          <mxGeometry height="165" width="700" x="80" y="105" as="geometry" />
        </mxCell>
        <mxCell id="comp_cli" parent="layer_pres" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.2;align=center;verticalAlign=top;spacingTop=4;fontColor=#000000;fontSize=11;" value="&lt;b&gt;CLI Interface Boundary&lt;/b&gt;&lt;br&gt;&lt;i&gt;challengehub/cli.py&lt;/i&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;p style=&quot;margin:0px; text-align:left; font-size:9.5px; line-height: 1.35;&quot;&gt;• Coordinates interactive user workflows (UC-04 View Progress, UC-05 Record Activity)&lt;br&gt;• Parses terminal inputs (participant_id, challenge_id, activity_type, amount, activity_date, note)&lt;br&gt;• Formats tabular console views and presents handled validation error notices (NFB-02)&lt;/p&gt;" vertex="1">
          <mxGeometry height="112" width="610" x="45" y="36" as="geometry" />
        </mxCell>
        <mxCell id="edge_cli_mgr" edge="1" parent="1" source="comp_cli" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;endArrow=block;endFill=1;" target="comp_mgr" value="Invokes record_activity() &amp;amp; progress()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_mgr_models" edge="1" parent="1" source="comp_mgr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#000000;fontColor=#000000;fontSize=9.5;exitX=0.126;exitY=1.009;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=open;endFill=0;exitPerimeter=0;" target="comp_models" value="Inspects &amp;amp; Instantiates">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="201.9" y="499" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_mgr_strat" edge="1" parent="1" source="comp_mgr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#000000;fontColor=#000000;fontSize=9.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=open;endFill=0;" target="comp_strat" value="Delegates Calculation">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_mgr_stor" edge="1" parent="1" source="comp_mgr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#000000;fontColor=#000000;fontSize=9.5;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=open;endFill=0;exitX=0.87;exitY=1.001;exitDx=0;exitDy=0;exitPerimeter=0;" target="comp_stor" value="Dispatches Persistence">
          <mxGeometry relative="1" x="-0.1468" as="geometry">
            <mxPoint x="650" y="498.1" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="audit_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#6c757d;strokeWidth=1;align=center;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=10;fontColor=#000000;fontSize=10;" value="&lt;b&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Architecture Audit &amp;amp; Boundary Fitness Rules&lt;/font&gt;&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;p style=&quot;margin:0px; text-align:left; font-size:9.5px; line-height: 1.4;&quot;&gt;&lt;b&gt;✓ Allowed Dependencies (Strictly Downward):&lt;/b&gt; Presentation (cli.py) → Application (manager.py) → Domain Core (models.py, strategies.py) &amp;amp; Storage (storage.py).&lt;br&gt;&lt;b&gt;✗ Forbidden Dependencies (Audited &amp;amp; Prevented):&lt;/b&gt; Domain models contain zero persistence or UI imports; Storage never imports Application/Presentation; CLI never bypasses ChallengeManager to access storage directly.&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="700" x="80" y="815" as="geometry" />
        </mxCell>
        <mxCell id="layer_dom" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f8f9fa;strokeColor=#6c757d;strokeWidth=1.5;fontSize=11;fontColor=#000000;rounded=1;arcSize=3;" value="&lt;b&gt;Domain Core &amp;amp; Persistence Layer&lt;/b&gt;" vertex="1">
          <mxGeometry height="210" width="700" x="80" y="585" as="geometry" />
        </mxCell>
        <mxCell id="comp_models" parent="layer_dom" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.2;align=center;verticalAlign=top;spacingTop=4;fontSize=11;fontColor=#000000;" value="&lt;b&gt;Domain Entities&lt;/b&gt;&lt;br&gt;&lt;i&gt;challengehub/models.py&lt;/i&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;p style=&quot;margin:0px; text-align:left; font-size:9.5px; line-height: 1.3;&quot;&gt;• Participant, Challenge, Enrollment&lt;br&gt;• ActivityRecord (Immutable dataclass)&lt;br&gt;• State representation &amp;amp; identity rules&lt;br&gt;&lt;b&gt;• Zero outbound I/O dependencies&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="145" width="195" x="25" y="45" as="geometry" />
        </mxCell>
        <mxCell id="comp_strat" parent="layer_dom" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.2;align=center;verticalAlign=top;spacingTop=4;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Progress Strategies&lt;/b&gt;&lt;br&gt;&lt;i&gt;challengehub/strategies.py&lt;/i&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;p style=&quot;margin:0px; text-align:left; font-size:9.5px; line-height: 1.3;&quot;&gt;• «interface» ProgressStrategy&lt;br&gt;• AmountProgressStrategy (Distance sum)&lt;br&gt;• CountProgressStrategy (Sessions count)&lt;br&gt;• Computes dynamic totals on query&lt;br&gt;&lt;b&gt;• No stored/persisted progress total&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="145" width="200" x="250" y="45" as="geometry" />
        </mxCell>
        <mxCell id="comp_stor" parent="layer_dom" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.2;align=center;verticalAlign=top;spacingTop=4;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Flat-File Persistence&lt;/b&gt;&lt;br&gt;&lt;i&gt;challengehub/storage.py&lt;/i&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;p style=&quot;margin:0px; text-align:left; font-size:9.5px; line-height: 1.3;&quot;&gt;• load_participants(), load_challenges()&lt;br&gt;• load_enrollments(), load_activities()&lt;br&gt;• save_activities() (Write-through append)&lt;br&gt;• Direct I/O to data/*.json and *.csv&lt;br&gt;&lt;b&gt;• Isolated from presentation &amp;amp; UI&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="145" width="200" x="475" y="45" as="geometry" />
        </mxCell>
        <mxCell id="layer_app" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f8f9fa;strokeColor=#6c757d;strokeWidth=1.5;fontSize=11;fontColor=#000000;rounded=1;arcSize=3;" value="&lt;b&gt;Application Coordination Layer&lt;/b&gt;" vertex="1">
          <mxGeometry height="185" width="700" x="80" y="335" as="geometry" />
        </mxCell>
        <mxCell id="comp_mgr" parent="layer_app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.2;align=center;verticalAlign=top;spacingTop=4;fontColor=#000000;fontSize=11;" value="&lt;b&gt;ChallengeManager (Application Coordinator)&lt;/b&gt;&lt;br&gt;&lt;i&gt;challengehub/manager.py&lt;/i&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;p style=&quot;margin:0px; text-align:left; font-size:9.5px; line-height: 1.35;&quot;&gt;• Central orchestrator for domain use cases (UC-05 Record Activity, UC-04 View Progress)&lt;br&gt;• Enforces preconditions in memory: referential check, active enrollment, date bounds, amount &amp;gt; 0&lt;br&gt;• Preserves failure invariant FB-04: raises specific ValueError with ZERO state mutation on failure&lt;br&gt;• Invokes ProgressStrategy dynamically on demand (UC-04 dynamic derived query without stored total)&lt;br&gt;• Triggers atomic write-through persistence to storage.py upon valid completion (FB-07)&lt;/p&gt;" vertex="1">
          <mxGeometry height="126" width="610" x="45" y="38" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
