  <diagram name="1 Architecture Overview &amp; Layering" id="PpM6b-UbHNveXZ8uzEzm">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hdr_banner" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#000066;strokeColor=none;" value="" vertex="1">
