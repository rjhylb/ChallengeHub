        <mxCell id="note_invariants" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#6c757d;strokeWidth=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;fontColor=#000000;fontSize=10;" value="&lt;b&gt;Class Model Invariants &amp;amp; Design Discipline (Lesson 4 &amp;amp; Lesson 5):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;No Persisted Progress State:&lt;/b&gt; Progress is never modeled as a mutable entity attribute or stored database column. It is dynamically derived via &lt;i&gt;progress(pid, cid)&lt;/i&gt; delegating to &lt;i&gt;ProgressStrategy.calculate()&lt;/i&gt;.&lt;br&gt;• &lt;b&gt;Cohesive Boundaries:&lt;/b&gt; UI widgets (buttons/input fields) and speculative database connection pools are excluded; only cohesive software entities and coordinators from the Lesson 7 implementation baseline are modeled.&lt;br&gt;• &lt;b&gt;Failure Invariant (FB-04):&lt;/b&gt; On validation failure, &lt;i&gt;_validate_preconditions()&lt;/i&gt; raises &lt;i&gt;ValueError&lt;/i&gt; prior to calling &lt;i&gt;ActivityRecord&lt;/i&gt; initialization or &lt;i&gt;save_activities()&lt;/i&gt;." vertex="1">
          <mxGeometry height="135" width="440" x="320" y="810" as="geometry" />
        </mxCell>
